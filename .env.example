# Copy to .env and fill in to use a real LLM. Without OPENROUTER_API_KEY,
# the API automatically falls back to FakeProvider (scripted, deterministic,
# no network) so the demo works out of the box.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# "auto" | "block" — see ApprovalGate (Decision #1)
APPROVAL_POLICY=auto

# Set to "fake" to force the deterministic demo provider even if a real
# API key is present (useful for local dev / CI). Set to "ollama" to use a
# local Ollama model instead of OpenRouter (no API key required).
LLM_PROVIDER=

# Ollama — local, OpenAI-compatible endpoint. Requires `ollama serve` and
# the model already pulled, e.g. `ollama pull qwen3.5:2b`.
OLLAMA_MODEL=qwen3-vl:8b-instruct
OLLAMA_BASE_URL=http://localhost:11434/v1
# Local inference (especially a small "thinking" model doing chain-of-thought
# on CPU) can take minutes per call — this is the read timeout, not a
# connect timeout, so a genuinely slow response isn't killed prematurely.
OLLAMA_TIMEOUT_S=300

# Demo aid: with the fake provider, pretend attempt 1 got routed to the
# safety model and re-routed once, so the safety-retry visual is watchable
# without a live OpenRouter key. Never affects pass/fail or attempt count.
GLASSBOX_SIMULATE_SAFETY=
